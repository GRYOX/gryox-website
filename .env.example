# Public production URL (canonical URLs, sitemap, Open Graph). Replace with the real domain.
NEXT_PUBLIC_SITE_URL=https://gryox.com

# Contact form delivery via Resend (https://resend.com). Leave empty to keep the form inert.
RESEND_API_KEY=
# Where contact submissions are delivered.
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "GRYOX <site@your-domain>".
CONTACT_FROM_EMAIL=
